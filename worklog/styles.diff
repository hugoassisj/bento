+.ed-props .ed-line > select, .ed-props .ed-line > .ed-color, .ed-props .ed-line > .ed-colorref,
+.ed-props .ed-line > .ed-seg, .ed-props .ed-line > .ed-mini { flex: 1 1 0; width: auto; }
+.ed-props .ed-line-even > * { flex: 1 1 0; }
+.ed-props .ed-line > .ed-seg-text { width: auto; }
+.ed-props .ed-grid2, .ed-props .ed-grid3 { display: grid; gap: 4px; margin-bottom: 6px; }
+.ed-props .ed-grid2 { grid-template-columns: 1fr 1fr; }
+.ed-props .ed-grid3 { grid-template-columns: 1fr 1fr 1fr; }
+.ed-props .ed-grid3 > *, .ed-props .ed-grid2 > * { min-width: 0; width: 100%; }
+.ed-props .ed-grid-wide { grid-template-columns: minmax(0, 1fr) 72px; }
+.ed-props .ed-grid2 > .ed-seg { width: 100%; }
+
+/* an icon inside a numeric field, where a word would be (rotation, radius, line height…) */
+.ed-mini > .ed-mini-icon { display: grid; place-items: center; max-width: none; }
+.ed-mini > .ed-mini-icon svg { width: 13px; height: 13px; }
+
+/* the block above the sections: toolbars, blend · opacity, measures */
+.ed-layer-block { margin-bottom: 2px; }
+.ed-toolbar { display: flex; align-items: center; gap: 2px; margin-bottom: 6px; flex-wrap: wrap; }
+.ed-toolbar-sep { width: 1px; height: 16px; margin: 0 3px; background: var(--line); }
+.ed-props .ed-tool {
+  flex: none; width: 26px; height: 26px; padding: 0; display: grid; place-items: center;
+  color: var(--ink-2); background: none; border: 1px solid transparent; border-radius: 6px;
+}
+.ed-props .ed-tool:hover:not(:disabled) { color: var(--ink); background: var(--chrome-2); }
+.ed-props .ed-tool:disabled { opacity: .35; cursor: default; }
+.ed-props .ed-tool svg { width: 15px; height: 15px; }
+
+/* a gradient stop: position · colour · remove, on one line */
+.ed-props .ed-gradstop { display: flex; flex-wrap: nowrap; align-items: center; gap: 4px; margin-bottom: 6px; }
+.ed-props .ed-gradstop > .ed-gradstop-at { flex: none; width: 60px; }
+.ed-props .ed-gradstop .ed-color-alpha { width: 52px; }
+.ed-props .ed-gradstop > .ed-color { order: 0; flex: 1 1 0; }
+.ed-props .ed-color-alpha { width: 58px; }
+.ed-props .ed-colorref { display: flex; flex-direction: column; gap: 4px; align-items: stretch; }
+.ed-props .ed-context { margin-top: 4px; }
+/* Penpot's chevron: inside the header's own padding, before the title */
+.ed-props .ed-section.ed-sec-toggle { padding-inline-start: 26px; }
+.ed-props .ed-section.ed-sec-toggle::before { inset-inline-start: 12px; top: calc(50% + 3px); }
+/* the native arrow keeps its own lane: a long value stops short of it */
+.ed-props select { padding-inline-end: 22px; text-overflow: ellipsis; }
+/* no spinner arrows: they ate a third of a narrow field, and the caption
+   scrubs (panels.ts scrub()) — arrows keys still step, as in Penpot */
+.ed-props input[type='number'] { -moz-appearance: textfield; appearance: textfield; }
+.ed-props input[type='number']::-webkit-inner-spin-button,
+.ed-props input[type='number']::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
+
+/* speaker notes: edge to edge under the canvas — under the two 5px resize
+   strips too, so the pane meets both side panels — and resized from its top
+   edge as the side panels are from theirs, with their chevron laid on its
+   side (notespane.ts). The text box keeps THE FIELD's look and fills the pane. */
+.ed-centre { position: relative; }
+.ed-notespane { position: relative; padding: 0 12px 10px; margin-inline: -5px; padding-inline: 17px; }
+.ed-notespane.closed { padding-bottom: 0; }
+.ed-resizer { z-index: 4; }
+.ed-notespane-head { padding: 8px 0 6px 14px; margin: 0; border: 0; }
+.ed-notespane-head.ed-sec-toggle::before { inset-inline-start: 1px; }
+.ed-notespane-text { display: block; width: 100%; margin: 0; resize: none; }
+.ed-notes-grip { position: absolute; inset-inline: 0; top: -3px; height: 6px; cursor: ns-resize; z-index: 5; transition: background .12s ease .08s; }
+.ed-notes-grip:hover, body.ed-row-resizing .ed-notes-grip { background: rgb(91 141 239 / 0.45); }
+.ed-notespane.closed .ed-notes-grip { cursor: default; background: none; }
+body.ed-row-resizing, body.ed-row-resizing * { cursor: ns-resize !important; user-select: none; }
+.ed-notes-toggle { width: 44px; height: 16px; font-size: 13px; }
+.ed-notes-toggle { transform: translate(-50%, -50%) rotate(0deg); }
+.ed-notespane .ed-notes-toggle { writing-mode: vertical-lr; }
+
+/* the side column's tabs are the inspector's: one look, one sticky band */
+.ed-sidebar { padding-top: 0; }
+.ed-sidebar > .ed-side-band {
+  position: sticky; top: 0; z-index: 3; flex: none; align-self: stretch; margin: 0 -12px; padding: 10px 12px 8px;
+  background: var(--surface); border-bottom: 1px solid var(--line);
+}
+.ed-side-tabs { margin: 0; }
+.ed-side-tabs button {
+  flex: 1 1 auto; height: 26px; text-transform: none; letter-spacing: 0; font-size: 12px; padding: 0 6px;
+  overflow: visible; text-overflow: clip;
+}
+
+/* theme colours (panels.ts themeLink) — Penpot's library: named, behind a button */
+.ed-props .ed-color > .ed-tool { width: 26px; }
+.ed-props .ed-tool[aria-expanded='true'] { color: var(--ink); background: var(--chrome-2); }
+.ed-color-token {
+  flex: 1 1 0; min-width: 0; height: 26px; box-sizing: border-box; display: flex; align-items: center; gap: 4px;
+  padding: 0 4px 0 8px; font-size: 12px; color: var(--ink); background: var(--chrome-2);
+  border: 1px solid var(--line); border-radius: 6px; overflow: hidden; white-space: nowrap;
+}
+.ed-color-token::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
+.ed-color-detach { margin-inline-start: auto; flex: none; width: 20px; height: 20px; padding: 0; display: grid; place-items: center; color: var(--muted); background: none; border: 0; border-radius: 4px; cursor: pointer; }
+.ed-color-detach:hover { color: var(--ink); background: var(--chrome); }
+.ed-color-detach svg { width: 13px; height: 13px; }
+.ed-palette { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; padding: 6px; background: var(--chrome); border: 1px solid var(--line); border-radius: 6px; }
+.ed-palette[hidden] { display: none; }
+.ed-palette-cap { grid-column: 1 / -1; font-size: 10.5px; font-weight: 600; letter-spacing: .04em; color: var(--muted); padding: 0 2px 2px; }
+.ed-palette-item { display: flex; align-items: center; gap: 6px; min-width: 0; height: 24px; padding: 0 4px; font: inherit; font-size: 11.5px; color: var(--ink-2); background: none; border: 0; border-radius: 4px; cursor: pointer; text-align: start; }
+.ed-palette-item > span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ed-palette-item:hover { color: var(--ink); background: var(--chrome-2); }
+.ed-palette-item.is-on { color: var(--ink); box-shadow: inset 0 0 0 1px var(--blue); }
+.ed-palette-item .ed-swatch { flex: none; }
+
+/* the one toolbar: kinds side by side, a hairline between, wrapping at a kind */
+.ed-toolbar { gap: 4px 0; }
+.ed-toolbar-kind { display: flex; align-items: center; gap: 0; }
+.ed-toolbar-kind + .ed-toolbar-kind { border-inline-start: 1px solid var(--line); padding-inline-start: 3px; margin-inline-start: 3px; }
+.ed-props .ed-toolbar .ed-tool { width: 21px; height: 26px; }
+.ed-props .ed-toolbar .ed-tool svg { width: 14px; height: 14px; }
+/* the layer list takes focus on every row click (keyboard order works from
+   there), and a 2px orange frame round the whole list on each click read as
+   "everything is selected". Focus shows on the selected row instead. */
+.ed-layers:focus-visible { box-shadow: none; }
+.ed-layers:focus-visible .ed-layer.sel { border-color: var(--blue); }
+.ed-layer-rename { flex: 1; min-width: 0; height: 20px; padding: 0 4px; font: inherit; font-size: 12px; }
+
+/* ————— review pass: every panel, both themes ———————————————————————————— */
+/* gradient stops: room for the whole hex */
+.ed-props .ed-gradstop > .ed-gradstop-at { width: 50px; }
+.ed-props .ed-gradstop .ed-color-alpha { width: 50px; }
+.ed-props .ed-color-hex { padding-inline: 6px; }
+/* a colour row with only swatch and hex (the theme's slots) stays on one
+   line beside its caption; with opacity or theme colours it takes the row */
+.ed-props .ed-row:has(> .ed-color) { grid-template-columns: minmax(0, 40%) minmax(0, 1fr); gap: 4px 8px; }
+.ed-props .ed-row:has(> .ed-color .ed-color-alpha), .ed-props .ed-row:has(> .ed-colorref) { grid-template-columns: minmax(0, 1fr); gap: 3px; }
+/* a full-width action: wraps inside the panel instead of running past it */
+.ed-props .ed-btn-block { box-sizing: border-box; width: 100%; max-width: 100%; min-height: 26px; height: auto; padding: 4px 8px; margin: 2px 0 6px; white-space: normal; line-height: 1.3; text-align: center; }
+/* chart axis range: caption above, min and max side by side */
+.ed-props .ed-row:has(> .ed-axis-range) { grid-template-columns: minmax(0, 1fr); gap: 3px; }
+.ed-props .ed-axis-range { display: grid; grid-template-columns: auto 1fr auto 1fr; align-items: center; gap: 4px 6px; }
+/* Reveal: three buttons with a button's look, sharing the row */
+.ed-props .ed-reveal-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-bottom: 6px; }
+.ed-props .ed-reveal-row .ed-arrange-cap { grid-column: 1 / -1; }
+.ed-props .ed-reveal-row .ed-btn {
+  height: 26px; padding: 0 4px; justify-content: center; font-size: 12px; color: var(--ink-2);
+  background: var(--field); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.ed-props .ed-reveal-row .ed-btn:hover:not(:disabled) { color: var(--ink); background: var(--chrome-2); }
+.ed-props .ed-axis-range input { width: 100%; min-width: 0; }
+.ed-props .ed-gradstop > .ed-gradstop-at { width: 56px; }
+.ed-props .ed-gradstop .ed-color-alpha { width: 48px; }
+.ed-props .ed-gradstop .ed-color-hex { padding-inline: 4px; }
+.ed-props .ed-gradstop > .ed-tool { width: 22px; }
+.ed-props .ed-gradstop > .ed-gradstop-at { width: 54px; }
+.ed-props .ed-gradstop .ed-color-alpha { width: 52px; }
+.ed-props .ed-gradstop .ed-color > input[type='color'] { width: 22px; }
+
+/* the toolbar uses the panel's width: the kinds share it by how many tools
+   each holds, and the tools share their kind's — bigger targets, the same line */
+.ed-props .ed-toolbar { flex-wrap: nowrap; gap: 0; }
+.ed-props .ed-toolbar-kind { flex: var(--n, 1) 1 0; min-width: 0; }
+.ed-props .ed-toolbar .ed-tool { flex: 1 1 0; width: auto; min-width: 20px; max-width: 40px; height: 30px; }
+.ed-props .ed-toolbar .ed-tool svg { width: 16px; height: 16px; }
+
+/* shadow presets as tiles (panels.ts buildShadow) */
+.ed-shadow-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin-bottom: 6px; }
+.ed-shadow-tile {
+  display: flex; flex-direction: column; align-items: center; gap: 5px; min-width: 0; padding: 8px 2px 5px;
+  font: inherit; font-size: 11px; color: var(--muted); background: var(--field); border: 1px solid var(--line); border-radius: 6px; cursor: pointer;
+}
+.ed-shadow-tile > span:last-child { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.ed-shadow-tile:hover { color: var(--ink); background: var(--chrome-2); }
+.ed-shadow-tile[aria-checked='true'] { color: var(--ink); border-color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue); }
+/* each preview is a small light card on a mid-grey patch, in both themes:
+   a dark shadow and a light glow both show there, as they would on a slide */
+.ed-shadow-swatch { width: 24px; height: 16px; border-radius: 3px; background: #ffffff; box-sizing: border-box; }
+.ed-shadow-tile { background-image: linear-gradient(#aeb7c4, #aeb7c4); background-size: 100% 30px; background-repeat: no-repeat; background-position: 0 0; }
+.ed-shadow-tile { padding-top: 7px; }
+.ed-shadow-tile > .ed-shadow-swatch { margin-bottom: 3px; }
+.ed-props .ed-line > .ed-mini-narrow { flex: none; width: 76px; }
+/* Tab strips (Slides | Layers, Format | Animate | Interact), Penpot's way: the
+   track sits apart from the panel (sunk, in dark) and the selected tab is a
+   lifted pill with a hairline edge, so the choice reads at a glance in both
+   themes. Text stays ≥4.5:1 in either state; hover brightens the text and
+   tints the slot, but never borders it, so it can't pass for selected. */
+.ed-tabs { background: var(--tab-track); box-shadow: inset 0 0 0 1px var(--line); }
+.ed-tabs button { border: 1px solid transparent; }
+.ed-tabs button:hover:not([aria-selected='true']) { color: var(--ink); background: var(--chrome-2); }
+.ed-tabs button[aria-selected='true'] {
+  color: var(--ink); background: var(--tab-on); border-color: var(--tab-on-line);
+  box-shadow: 0 1px 2px rgb(0 0 0 / .18);
+}
